{
  "name": "pi-annotate-electron",
  "version": "0.1.0",
  "description": "Point at your Electron UI, annotate it, and send precise feedback to your Pi coding session.",
  "type": "module",
  "license": "MIT",
  "author": "Leonardo Scricca",
  "homepage": "https://github.com/leoscricca/pi-annotate-electron#readme",
  "bugs": {
    "url": "https://github.com/leoscricca/pi-annotate-electron/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pi-annotate-electron": "bin/launch.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "electron",
    "annotation",
    "developer-tools",
    "ui-feedback"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoscricca/pi-annotate-electron.git"
  },
  "pi": {
    "extensions": [
      "./extensions/annotate-electron.ts"
    ],
    "image": "https://raw.githubusercontent.com/leoscricca/pi-annotate-electron/v0.1.0/docs/media/preview.png",
    "video": "https://raw.githubusercontent.com/leoscricca/pi-annotate-electron/v0.1.0/docs/media/demo.mp4"
  },
  "files": [
    "extensions",
    "scripts/electron-annotations",
    "scripts/electron-development-ui",
    "scripts/build-fixture.mjs",
    "bin",
    "fixtures",
    "out",
    "design",
    "docs/media",
    "docs/ARCHITECTURE.md",
    "docs/DEVELOPMENT_UI_CONNECTION.md",
    "docs/ELECTRON_DEVELOPMENT_UI_PROTOCOL.md",
    "docs/ELECTRON_ANNOTATION_FEEDBACK.md",
    "docs/RELEASING.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/VERIFICATION.md",
    "docs/MIGRATION.md"
  ],
  "scripts": {
    "prepare": "node scripts/build-fixture.mjs",
    "prepack": "node scripts/build-fixture.mjs",
    "build": "node scripts/build-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "check:package": "node scripts/check-package.mjs",
    "start:app": "node bin/launch.mjs",
    "demo": "npm run build && PLAYWRIGHT_BROWSERS_PATH=0 node scripts/capture-demo.mjs"
  },
  "dependencies": {
    "electron": "44.9.3",
    "pi-annotate": "0.5.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "typebox": "1.3.36",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0"
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
