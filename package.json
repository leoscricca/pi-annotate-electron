{
  "name": "pi-annotate-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Pi annotation and bounded UI tools for explicitly bootstrapped development Electron apps",
  "type": "module",
  "license": "UNLICENSED",
  "keywords": ["pi-package", "electron", "annotation"],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/leoscricca/pi-annotate-electron.git"
  },
  "pi": {
    "extensions": ["./extensions/annotate-electron.ts"]
  },
  "files": ["extensions", "scripts", "bin", "fixtures", "design", "docs", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "build": "node scripts/build-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "check:package": "node scripts/check-package.mjs",
    "start:app": "node bin/launch.mjs"
  },
  "dependencies": {
    "electron": "44.4.5",
    "pi-annotate": "0.5.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "typebox": "1.3.36"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0"
  },
  "engines": {"node": ">=24.22.0"}
}
